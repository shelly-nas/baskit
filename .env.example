# Baskit server and database (docker compose)
DB_NAME=baskit
DB_USER=baskit
DB_PASSWORD=change_this_password

# Signs sign-in tokens; at least 32 random characters in production.
JWT_SECRET=change_this_to_a_long_random_string_of_32_chars

# Accounts with these emails become admin when they register or sign in.
ADMIN_EMAILS=

# Where nginx forwards /api/discounts (the discount-scraper API).
DISCOUNT_API_UPSTREAM=http://host.docker.internal:3001
