server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json application/wasm image/svg+xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    # Discount data from the discount-scraper public API (read-only).
    # Longer prefix than /api/, so it wins for /api/discounts/.
    location /api/discounts/ {
        # Resolved per request through Docker's DNS, not once at startup: the
        # discount-scraper runs in another stack and may be (re)deploying, and
        # nginx would otherwise refuse to start while it is unreachable.
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $discount_api ${DISCOUNT_API_UPSTREAM};
        rewrite ^/api/discounts/(.*)$ /api/public/v1/$1 break;
        proxy_pass $discount_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # Baskit accounts and lists (baskit server)
    location /api/ {
        proxy_pass ${BASKIT_API_UPSTREAM}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        client_max_body_size 1m;
    }

    # Never cache the entry points so new releases are picked up immediately
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
    location = /flutter_bootstrap.js {
        add_header Cache-Control "no-cache";
    }
    location = /flutter_service_worker.js {
        add_header Cache-Control "no-cache";
    }

    # Single page app fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
